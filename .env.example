# ── App ────────────────────────────────────────────────────────────────
# Public URL of the site (used in emails and payment redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign login links and session cookies. Use a long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Comma-separated list of admin emails (server-side authorization)
ADMIN_EMAILS=you@example.com

# ── Payments ───────────────────────────────────────────────────────────
# "mock"  → built-in demo gateway (no real money, clearly labeled as a demo)
# "chapa" → Chapa (https://chapa.co) — Ethiopian NBE-licensed gateway:
#           telebirr, CBE Birr, local bank cards + international Visa/Mastercard
PAYMENT_PROVIDER=mock

# Chapa credentials (dashboard.chapa.co → Settings → API)
CHAPA_SECRET_KEY=
# Secret you configure for Chapa webhooks (used to verify x-chapa-signature)
CHAPA_WEBHOOK_SECRET=
# Currency to charge in. Most Chapa accounts settle in ETB.
CHAPA_CURRENCY=ETB
# Amounts to charge in CHAPA_CURRENCY. If you charge in ETB, set these to the
# ETB equivalents of the display prices (e.g. 19 USD ≈ your ETB price).
CHAPA_AMOUNT_COURSE=19
CHAPA_AMOUNT_VIP=499

# ── Email ──────────────────────────────────────────────────────────────
# Without a key, emails are printed to the server console (dev mode).
# With a Resend API key (https://resend.com), real emails are sent.
RESEND_API_KEY=
EMAIL_FROM=FirstStore <access@yourdomain.com>
