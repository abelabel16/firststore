# ── Local development ──────────────────────────────────────────────────
# Copy to .env.local and fill in. In production these are set as GitHub
# Actions variables (Settings → Secrets and variables → Actions → Variables).

# Supabase project (supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave empty locally; the deploy workflow sets /firststore for GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# ── Supabase Edge Function secrets (NOT here — set in the Supabase
#    dashboard under Edge Functions → Secrets, or `supabase secrets set`) ──
# DEMO_PAYMENTS=true            # demo gateway while testing (no real money)
# SITE_URL=https://abelabel16.github.io/firststore
# CHAPA_SECRET_KEY=...          # chapa.co live credentials
# CHAPA_WEBHOOK_SECRET=...
# CHAPA_CURRENCY=ETB
# CHAPA_AMOUNT_COURSE=...       # amount in CHAPA_CURRENCY
# CHAPA_AMOUNT_VIP=...
